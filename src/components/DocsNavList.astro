---
import { DOCS, REFERENCE, currentMark, type pageContents } from '../docs-nav';

interface Props {
  contents?: ReturnType<typeof pageContents>;
}

const { contents } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const here = Astro.url.pathname.replace(/\/?$/, '/').slice(base.length + 1);
const href = (path: string) => `${base}/${path}`;
const current = (path: string) => currentMark(here, path);
---

{contents ? (
  <ul class="docs-contents">
    {contents.map((h) => <li>
      {h.children.length ? (
        <details>
          <summary>{h.text}</summary>
          <ul>
            <li><a href={`#${h.slug}`}>{h.text}</a></li>
            {h.children.map((child) => <li><a href={`#${child.slug}`}>{child.text}</a></li>)}
          </ul>
        </details>
      ) : <a href={`#${h.slug}`}>{h.text}</a>}
    </li>)}
  </ul>
) : (
  <ul>
    {DOCS.map((d) => (
      <li>
        <a href={href(d.path)} aria-current={current(d.path)}>{d.label}</a>
        {d.path === 'docs/reference/' && (
          <ul>
            {REFERENCE.map((r) => <li><a href={href(r.path)} aria-current={current(r.path)}>{r.label}</a></li>)}
          </ul>
        )}
      </li>
    ))}
  </ul>
)}
