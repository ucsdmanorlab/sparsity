const base = import.meta.env.BASE_URL;
const dataHost = import.meta.env.DEV ? 'http%3A%2F%2Flocalhost%3A9091%2Fdata' : 'https%3A%2F%2Fucsdmanorlab.github.io%2Fsparsity%2Fdata';
