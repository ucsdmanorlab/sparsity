---
const base = import.meta.env.BASE_URL;
---
<!-- Hero / Header -->
<header class="hero">
  <figure class="hero-gif no-frame no-invert" style="margin: 0;">
    <!-- Two pre-composited MP4s: dark variant is on #191b1f, light on #ffffff.
         A MutationObserver swaps src when the user toggles the theme.
         Sizing: grow the video to fill the viewport minus space needed for title + authors.
         Video aspect ratio is 1920:900 = 2.1333. Cap height at 75vh; derive max-width so
         the natural aspect ratio keeps it from overflowing. -->
    <video id="hero-video" autoplay loop muted playsinline preload="auto"
           src={`${base}/header_light.mp4`}
           data-src-dark={`${base}/header_dark.mp4`}
           data-src-light={`${base}/header_light.mp4`}
           style="width: 100%; max-width: min(1920px, calc(75vh * 2.1333)); height: auto; border-radius: 6px; display: block; margin: 0 auto;">
    </video>
  </figure>
  <script is:inline>
    (function () {
      const v = document.getElementById('hero-video');
      const html = document.documentElement;
      function apply() {
        const isLight = html.getAttribute('data-theme') === 'light';
        const target = isLight ? v.dataset.srcLight : v.dataset.srcDark;
        if (v.src && v.src.endsWith(target)) { v.play().catch(() => {}); return; }
        const t = v.currentTime || 0;
        v.src = target;
        const resume = () => {
          try { v.currentTime = t % (v.duration || 1); } catch (e) {}
          v.play().catch(() => {});
        };
        if (v.readyState >= 1) resume();
        else v.addEventListener('loadedmetadata', resume, { once: true });
      }
      apply();
      new MutationObserver(apply).observe(html, { attributes: true, attributeFilter: ['data-theme'] });
    })();
  </script>

  <h1>Bootstrapping Dense 3D Segmentations from Sparse 2D Annotations</h1>

  <div class="authors">
    <div class="author">
      <a class="name" href="https://scholar.google.com/citations?user=RbHkzpgAAAAJ" target="_blank" rel="noopener">Vijay Venu Thiyagarajan</a>
      <div class="affiliation">UT Austin</div>
    </div>
    <div class="author">
      <a class="name" href="https://scholar.google.com/citations?user=MTh-g8YAAAAJ" target="_blank" rel="noopener">Arlo Sheridan</a>
      <div class="affiliation">Salk Institute</div>
    </div>
    <div class="author">
      <a class="name" href="https://scholar.google.com/citations?user=8P7Ymn4AAAAJ" target="_blank" rel="noopener">Kristen M. Harris</a>
      <div class="affiliation">UT Austin</div>
    </div>
    <div class="author">
      <a class="name" href="https://scholar.google.com/citations?user=_ZLy6tEAAAAJ" target="_blank" rel="noopener">Uri Manor</a>
      <div class="affiliation">UCSD / Salk Institute</div>
    </div>
  </div>

  <div class="links">
    <a href="https://www.biorxiv.org/content/10.1101/2024.06.14.599135v2" target="_blank" rel="noopener">Paper</a>
    <a href="https://github.com/ucsdmanorlab/bootstrapper" target="_blank" rel="noopener">GitHub</a>
    <a href="https://github.com/ucsdmanorlab/napari-bootstrapper" target="_blank" rel="noopener">Napari Plugin</a>
  </div>
</header>
