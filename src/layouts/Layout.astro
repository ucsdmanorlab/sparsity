---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "A general method for bootstrapping dense 3D segmentations from sparse 2D annotations" } = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname.replace(/\/?$/, '/'), Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${base}/fig2a_pipeline.png`} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${base}/fig2a_pipeline.png`} />

    <link rel="icon" type="image/svg+xml" href={`${base}/logos/cells-r270-c3.svg`} />
    <!-- Set the theme before the body paints, so a slow load does not show the other theme first. -->
    <script is:inline>
      if (localStorage.getItem('theme') !== 'dark') document.documentElement.setAttribute('data-theme', 'light');
    </script>
  </head>
  <body>
    <button class="theme-toggle" id="theme-toggle" aria-label="Toggle light/dark mode"></button>
    <slot />
    <script is:inline>
      const toggle = document.getElementById('theme-toggle');
      const html = document.documentElement;
      const saved = localStorage.getItem('theme');
      // Default to light unless the user has explicitly chosen dark before.
      const initial = saved === 'dark' ? 'dark' : 'light';
      if (initial === 'light') html.setAttribute('data-theme', 'light');
      function updateIcon() {
        toggle.textContent = html.getAttribute('data-theme') === 'light' ? '\u263E' : '\u2600';
      }
      updateIcon();
      toggle.addEventListener('click', () => {
        const next = html.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
        if (next === 'dark') html.removeAttribute('data-theme');
        else html.setAttribute('data-theme', 'light');
        localStorage.setItem('theme', next);
        updateIcon();
      });
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
